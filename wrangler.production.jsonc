{
  // Production Worker fuckim50. Deploy from GitHub main with:
  // npx wrangler deploy --config wrangler.production.jsonc
  "name": "fuckim50",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-21",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "fi50.show", "zone_name": "fi50.show", "custom_domain": true },
    { "pattern": "fuckim50.show", "zone_name": "fuckim50.show", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/things-im-doing", "/things-im-doing/*"]
  }
}
