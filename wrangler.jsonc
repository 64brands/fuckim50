{
  // Default Wrangler config. Same Worker as wrangler.production.jsonc.
  // Preview Worker fuckim50-preview has been removed and must not be recreated.
  // Standard production deploy (from GitHub main):
  //   npx wrangler deploy --config wrangler.production.jsonc
  "name": "fuckim50",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-21",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "im50show.com", "zone_name": "im50show.com", "custom_domain": true },
    { "pattern": "www.im50show.com", "zone_name": "im50show.com", "custom_domain": true },
    { "pattern": "theim50show.com", "zone_name": "theim50show.com", "custom_domain": true },
    { "pattern": "fi50.show", "zone_name": "fi50.show", "custom_domain": true },
    { "pattern": "fuckim50.show", "zone_name": "fuckim50.show", "custom_domain": true },
    { "pattern": "www.theim50show.com", "zone_name": "theim50show.com", "custom_domain": true },
    { "pattern": "www.fi50.show", "zone_name": "fi50.show", "custom_domain": true },
    { "pattern": "www.fuckim50.show", "zone_name": "fuckim50.show", "custom_domain": true }
  ],
  // run_worker_first: true so the old domains reach the Worker and 301-redirect
  // to im50show.com before any static file is served.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
